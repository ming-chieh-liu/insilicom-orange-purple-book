# Database credentials — never commit
creds.json

# Python
__pycache__/
*.py[cod]

# Local scratch
*.log
.DS_Store

# Downloaded FDA/reference bulk data (large, rebuildable)
fda_raw/

# ProjectPortal local state (never commit)
.portal/

# Test and type-check caches
.coverage
coverage.json
.pytest_cache/
.mypy_cache/
*.egg-info/

# Superseded probes and one-off outputs; kept on disk, out of the package
scratch/

# Generated tables; reproducible with `main.py --mode map`
output/

# Adjudication work files — derived from fda_raw/, rebuilt by
# `main.py --mode adjudicate-prepare` and `--mode adjudicate-combine`.
# adjudication/verdicts.jsonl and adjudication/raw/ are NOT ignored: they are
# the curated record of what the judges actually said, and cost agent calls.
adjudication/batches/
adjudication/units.jsonl
adjudication/judged.jsonl
adjudication/tiebreak_needed.txt

# P4 judging units: rebuilt by --mode identify-prepare, not curated
adjudication/identify_units.jsonl
adjudication/identify_judged.jsonl
adjudication/identify_tiebreak_needed.txt

# Unpacked raw data for manual inspection
examine/

# Review-trial-role judging units: rebuilt by the pilot builder, not curated
adjudication/review_role_units.jsonl
adjudication/label_role_units.jsonl
adjudication/precision_p4_v1/units.jsonl
adjudication/review_role_tiebreak_needed.txt
adjudication/letter_locate_units.jsonl
adjudication/letter_verify_units.jsonl
adjudication/letter_candidate_units.jsonl
.deps.mk

# Rendered pool prompts — rebuilt from the units by render-prompts
adjudication/**/*.requests.jsonl
adjudication/**/*.requests-x*.jsonl
